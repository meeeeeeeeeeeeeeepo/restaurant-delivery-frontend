{
  "name": "restaurant-delivery-frontend",
  "version": "1.0.0",
  "description": "React + Vite + urql frontend; typed operations generated from the shared GraphQL schema",
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "npm run codegen && vite",
    "build": "npm run codegen && vite build",
    "preview": "vite preview --port 4173 --host",
    "lint": "tsc --noEmit",
    "test": "npm run codegen && tsc --noEmit"
  },
  "dependencies": {
    "@meeeeeeeeeeeeeeepo/restaurant-schema": "0.1.0",
    "graphql": "^16.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "urql": "^4.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/client-preset": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
